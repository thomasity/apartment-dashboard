# Server
PORT=3001

# Set to false on your local machine to skip real device connections and use mock data
# PROD=false

# Spotify Web API — https://developer.spotify.com/dashboard
# Run `node server/scripts/spotify-auth.js` once to get your refresh token
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=

# MQTT broker (Mosquitto) — controls Zigbee lights
# Set to mqtt://localhost:1883 if running Mosquitto on the same Pi
MQTT_BROKER_URL=mqtt://localhost:1883

# Roku Stick local IP — find it in Settings → Network → About on the Roku
# Tip: reserve this IP in your router's DHCP settings so it doesn't change
ROKU_IP=192.168.1.XXX

LAT=38.6270
LON=-90.1994

# Alpaca Markets API — https://alpaca.markets/
# Create a free account to get paper trading API keys
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Comma-separated stock symbols to display
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA
