{
  // Tests run under Vitest (Vite resolution), not Node's — so resolve like a bundler and
  // allow extensionless dynamic import(). Checked by `npm run typecheck`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"],
  "exclude": []
}
